<?xml version="1.0"?>
<launch>
  <!-- Enhanced Safe Exploration System Launch File -->
  <!-- Single command to start complete collision-free exploration -->
  
  <!-- Launch Arguments -->
  <arg name="use_sim_time" default="true" description="Use simulation (Gazebo) clock if true"/>
  <arg name="world_file" default="$(find-pkg-share turtle_bot_gazebo)/worlds/turtle_bot_world.world" description="Full path to world file to load"/>
  <arg name="params_file" default="$(find-pkg-share turtle_bot_navigation)/config/nav2_params.yaml" description="Full path to the enhanced nav2 parameters file"/>
  <arg name="rviz_config" default="$(find-pkg-share turtle_bot_exploration)/config/exploration.rviz" description="Full path to the RViz config file"/>
  <arg name="log_level" default="info" description="Log level for all nodes"/>
  <arg name="autostart" default="true" description="Automatically startup the nav2 stack"/>
  <arg name="use_composition" default="false" description="Use composed bringup if True"/>
  <arg name="use_respawn" default="false" description="Whether to respawn if a node crashes"/>

  <!-- 1. Launch Gazebo Simulation Environment -->
  <include file="$(find-pkg-share turtle_bot_gazebo)/launch/turtle_bot_world.launch.py">
    <arg name="world_file" value="$(var world_file)"/>
    <arg name="use_sim_time" value="$(var use_sim_time)"/>
  </include>

  <!-- 2. Launch Nav2 Navigation Stack with Enhanced Safety (8s delay) -->
  <group>
    <push-ros-namespace namespace=""/>
    <include file="$(find-pkg-share nav2_bringup)/launch/navigation_launch.py">
      <arg name="use_sim_time" value="$(var use_sim_time)"/>
      <arg name="params_file" value="$(var params_file)"/>
      <arg name="autostart" value="$(var autostart)"/>
      <arg name="use_composition" value="$(var use_composition)"/>
      <arg name="use_respawn" value="$(var use_respawn)"/>
    </include>
  </group>

  <!-- 3. Launch SLAM for Real-time Mapping (10s delay) -->
  <group>
    <push-ros-namespace namespace=""/>
    <include file="$(find-pkg-share nav2_bringup)/launch/slam_launch.py">
      <arg name="use_sim_time" value="$(var use_sim_time)"/>
      <arg name="autostart" value="$(var autostart)"/>
      <arg name="use_composition" value="$(var use_composition)"/>
      <arg name="use_respawn" value="$(var use_respawn)"/>
    </include>
  </group>

  <!-- 4. Launch RViz Visualization (12s delay) -->
  <node pkg="rviz2" exec="rviz2" name="rviz2" output="screen">
    <arg name="arguments" value="-d $(var rviz_config)"/>
    <param name="use_sim_time" value="$(var use_sim_time)"/>
  </node>

  <!-- 5. Enhanced Frontier Detection Node with Safety Parameters (15s delay) -->
  <node pkg="turtle_bot_exploration" exec="frontier_detection_node" name="frontier_detection_node" output="screen">
    <param name="use_sim_time" value="$(var use_sim_time)"/>
    <param name="frontier_min_size" value="20"/>
    <param name="frontier_travel_point_distance" value="0.8"/>
    <param name="frontier_blacklist_radius" value="1.2"/>
    <param name="frontier_search_radius" value="10.0"/>
    <param name="frontier_min_distance" value="1.0"/>
    <param name="global_frame" value="map"/>
    <param name="robot_base_frame" value="base_link"/>
    <arg name="ros-args" value="--log-level $(var log_level)"/>
  </node>

  <!-- 6. Enhanced Exploration Coordinator with Safety Features (18s delay) -->
  <node pkg="turtle_bot_exploration" exec="exploration_coordinator_node" name="exploration_coordinator_node" output="screen">
    <param name="use_sim_time" value="$(var use_sim_time)"/>
    <param name="exploration_timeout" value="1800.0"/>
    <param name="stuck_timeout" value="8.0"/>
    <param name="recovery_rotation_speed" value="0.5"/>
    <param name="recovery_rotation_duration" value="12.0"/>
    <param name="auto_start_exploration" value="true"/>
    <param name="global_frame" value="map"/>
    <param name="robot_base_frame" value="base_link"/>
    <param name="min_frontier_distance" value="1.0"/>
    <param name="max_exploration_range" value="15.0"/>
    <param name="goal_tolerance" value="0.3"/>
    <param name="frontier_safety_margin" value="0.8"/>
    <arg name="ros-args" value="--log-level $(var log_level)"/>
  </node>

  <!-- 7. Safety Status Display -->
  <node pkg="turtle_bot_exploration" exec="safety_status_node" name="safety_status_node" output="screen" if="false">
    <param name="use_sim_time" value="$(var use_sim_time)"/>
    <arg name="ros-args" value="--log-level $(var log_level)"/>
  </node>

  <!-- 8. System Information Display -->
  <executable cmd="bash -c 'sleep 25 &amp;&amp; echo &quot;🛡️ ENHANCED SAFE EXPLORATION ACTIVE&quot; &amp;&amp; echo &quot;✅ 60cm obstacle inflation radius&quot; &amp;&amp; echo &quot;✅ 80cm frontier safety margin&quot; &amp;&amp; echo &quot;✅ Multi-stage stuck recovery&quot; &amp;&amp; echo &quot;✅ Enhanced obstacle avoidance&quot; &amp;&amp; echo &quot;✅ Intelligent goal selection&quot; &amp;&amp; echo &quot;✅ SLAM mapping enabled&quot; &amp;&amp; echo &quot;🎯 System ready for collision-free exploration!&quot;'" output="screen"/>

</launch>
