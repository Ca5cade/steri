<?xml version="1.0"?>
<launch>
  <!-- Minimal Enhanced Safe Exploration -->
  
  <!-- Arguments -->
  <arg name="use_sim_time" default="true"/>
  
  <!-- Gazebo World -->
  <include file="$(find-pkg-share turtle_bot_gazebo)/launch/gazebo.launch.py"/>
  
  <!-- Navigation with Enhanced Safety -->
  <include file="$(find-pkg-share turtle_bot_navigation)/launch/turtle_bot_navigation.launch.py"/>
  
  <!-- Enhanced Frontier Detection -->
  <node pkg="turtle_bot_exploration" exec="frontier_detector" name="frontier_detector" output="screen">
    <param name="use_sim_time" value="true"/>
    <param name="frontier_min_size" value="20"/>
    <param name="frontier_travel_point_distance" value="0.8"/>
    <param name="frontier_blacklist_radius" value="1.2"/>
    <param name="frontier_search_radius" value="10.0"/>
    <param name="frontier_min_distance" value="1.0"/>
  </node>
  
  <!-- Enhanced Exploration Coordinator -->
  <node pkg="turtle_bot_exploration" exec="exploration_coordinator" name="exploration_coordinator" output="screen">
    <param name="use_sim_time" value="true"/>
    <param name="exploration_timeout" value="1800.0"/>
    <param name="stuck_timeout" value="8.0"/>
    <param name="recovery_rotation_speed" value="0.5"/>
    <param name="recovery_rotation_duration" value="12.0"/>
    <param name="auto_start_exploration" value="true"/>
    <param name="min_frontier_distance" value="1.0"/>
    <param name="max_exploration_range" value="15.0"/>
    <param name="goal_tolerance" value="0.3"/>
    <param name="frontier_safety_margin" value="0.8"/>
  </node>
  
</launch>
